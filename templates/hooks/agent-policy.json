{
  "hooks": {
    "SessionStart": [
      { "type": "command", "command": "node /absolute/path/to/agent-policy.mjs SessionStart", "timeout": 5 }
    ],
    "UserPromptSubmit": [
      { "type": "command", "command": "node /absolute/path/to/agent-policy.mjs UserPromptSubmit", "timeout": 5 }
    ],
    "SubagentStart": [
      { "type": "command", "command": "node /absolute/path/to/agent-policy.mjs SubagentStart", "timeout": 5 }
    ]
  }
}
